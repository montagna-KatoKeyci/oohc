&lt;hr&gt;
&lt;h3 id=&#34;コースマップ&#34;&gt;コースマップ&lt;/h3&gt;







&lt;link rel=&#34;stylesheet&#34; href=&#34;https://unpkg.com/leaflet@1.9.4/dist/leaflet.css&#34; /&gt;

&lt;style&gt;
  .gpx-container {
    width: 100%;
    margin: 1.5rem 0;
    border: 1px solid #ccc;
    border-radius: 8px;
    overflow: hidden;
    background-color: #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  }
  .gpx-summary {
    background-color: #f8f9fa;
    padding: 12px 16px;
    border-bottom: 1px solid #e9ecef;
    font-size: 0.9rem;
    color: #333;
    display: flex;
    gap: 18px;
    flex-wrap: wrap;
    align-items: center;
  }
  .gpx-summary-item {
    display: flex;
    flex-direction: column;
  }
  .gpx-summary-label {
    font-size: 0.75rem;
    color: #666;
  }
  .gpx-summary-val {
    font-size: 1rem;
    font-weight: bold;
  }
  .gpx-map {
    height: 420px;
    width: 100%;
    z-index: 1;
  }
  body.dark .gpx-container { border-color: #444; background-color: #1a1a1a; }
  body.dark .gpx-summary { background-color: #2a2a2a; border-bottom-color: #444; color: #eee; }
  body.dark .gpx-summary-label { color: #aaa; }
&lt;/style&gt;

&lt;div class=&#34;gpx-container&#34;&gt;
  
  &lt;div id=&#34;summary-a94201a3&#34; class=&#34;gpx-summary&#34;&gt;
    &lt;span&gt;データ解析中...&lt;/span&gt;
  &lt;/div&gt;
  
  &lt;div id=&#34;map-a94201a3&#34; class=&#34;gpx-map&#34;&gt;&lt;/div&gt;
&lt;/div&gt;


&lt;script src=&#34;https://unpkg.com/leaflet@1.9.4/dist/leaflet.js&#34;&gt;&lt;/script&gt;
&lt;script src=&#34;https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/1.7.0/gpx.min.js&#34;&gt;&lt;/script&gt;

&lt;script&gt;
window.addEventListener(&#39;load&#39;, function() {
  var targetUrl = &#39;\/oohc\/gpx\/20260509_20260509.gpx&#39;;
  var map = L.map(&#39;map-a94201a3&#39;);

  L.tileLayer(&#39;https://cyberjapandata.gsi.go.jp/xyz/std/{z}/{x}/{y}.png&#39;, {
    attribution: &#39;&lt;a href=&#34;https://maps.gsi.go.jp/development/ichiran.html&#34; target=&#34;_blank&#34;&gt;国土地理院&lt;/a&gt;&#39;,
    maxZoom: 18
  }).addTo(map);

  new L.GPX(targetUrl, {
    async: true,
    polyline_options: { color: &#39;#ff3300&#39;, weight: 4, opacity: 0.8 },
    marker_options: {
      startIconUrl: &#39;https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png&#39;,
      endIconUrl: &#39;https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png&#39;,
      shadowUrl: &#39;https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png&#39;,
      wptIconUrls: { &#39;&#39;: null },
      
      pointMatchers: []
    }
  }).on(&#39;loaded&#39;, function(e) {
    var gpx = e.target;
    map.fitBounds(gpx.getBounds());

    var distKm = (gpx.get_distance() / 1000).toFixed(2);
    var eleGain = Math.round(gpx.get_elevation_gain());
    var eleLoss = Math.round(gpx.get_elevation_loss());
    var eleMax = Math.round(gpx.get_elevation_max());
    var eleMin = Math.round(gpx.get_elevation_min());

    document.getElementById(&#39;summary-a94201a3&#39;).innerHTML = 
      &#39;&lt;div class=&#34;gpx-summary-item&#34;&gt;&lt;span class=&#34;gpx-summary-label&#34;&gt;総距離&lt;/span&gt;&lt;span class=&#34;gpx-summary-val&#34;&gt;&#39; + distKm + &#39; km&lt;/span&gt;&lt;/div&gt;&#39; +
      &#39;&lt;div class=&#34;gpx-summary-item&#34;&gt;&lt;span class=&#34;gpx-summary-label&#34;&gt;累積標高（上り）&lt;/span&gt;&lt;span class=&#34;gpx-summary-val&#34;&gt;+&#39; + eleGain + &#39; m&lt;/span&gt;&lt;/div&gt;&#39; +
      &#39;&lt;div class=&#34;gpx-summary-item&#34;&gt;&lt;span class=&#34;gpx-summary-label&#34;&gt;累積標高（下り）&lt;/span&gt;&lt;span class=&#34;gpx-summary-val&#34;&gt;-&#39; + eleLoss + &#39; m&lt;/span&gt;&lt;/div&gt;&#39; +
      &#39;&lt;div class=&#34;gpx-summary-item&#34;&gt;&lt;span class=&#34;gpx-summary-label&#34;&gt;最高/最低標高&lt;/span&gt;&lt;span class=&#34;gpx-summary-val&#34;&gt;&#39; + eleMax + &#39;m / &#39; + eleMin + &#39;m&lt;/span&gt;&lt;/div&gt;&#39;;
  }).addTo(map);
});
&lt;/script&gt;
&lt;h2 id=&#34;hahahugoshortcode26s1hbhb&#34;&gt;




&lt;style&gt;
  .gpx-chart-card {
    width: 100%;
    margin: 1.5rem 0;
    border: 1px solid #ccc;
    border-radius: 8px;
    background-color: #fafafa;
    padding: 12px;
    box-sizing: border-box;
    box-shadow: 0 2px 5px rgba(0,0,0,0.05);
  }
  .gpx-chart-wrapper {
    height: 200px;
    width: 100%;
    position: relative;
  }
  body.dark .gpx-chart-card { border-color: #444; background-color: #222; }
&lt;/style&gt;

&lt;div class=&#34;gpx-chart-card&#34;&gt;
  &lt;div class=&#34;gpx-chart-wrapper&#34;&gt;
    &lt;canvas id=&#34;chart-a94201a3&#34;&gt;&lt;/canvas&gt;
  &lt;/div&gt;
&lt;/div&gt;

&lt;script src=&#34;https://cdn.jsdelivr.net/npm/chart.js&#34;&gt;&lt;/script&gt;

&lt;script&gt;
window.addEventListener(&#39;load&#39;, function() {
  var gpxUrl = &#39;\/oohc\/gpx\/20260509_20260509.gpx&#39;;

  
  function getDistanceKm(lat1, lon1, lat2, lon2) {
    var R = 6371; 
    var dLat = (lat2 - lat1) * Math.PI / 180;
    var dLon = (lon2 - lon1) * Math.PI / 180;
    var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
            Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
            Math.sin(dLon/2) * Math.sin(dLon/2);
    var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  
  fetch(gpxUrl)
    .then(function(response) { return response.text(); })
    .then(function(xmlText) {
      var parser = new DOMParser();
      var xmlDoc = parser.parseFromString(xmlText, &#34;text/xml&#34;);
      var trkpts = xmlDoc.getElementsByTagName(&#34;trkpt&#34;);

      var labels = [];
      var eleValues = [];
      var totalDist = 0;

      var prevLat = null;
      var prevLon = null;

      for (var i = 0; i &lt; trkpts.length; i++) {
        var pt = trkpts[i];
        var lat = parseFloat(pt.getAttribute(&#34;lat&#34;));
        var lon = parseFloat(pt.getAttribute(&#34;lon&#34;));
        var eleNode = pt.getElementsByTagName(&#34;ele&#34;)[0];
        
        if (eleNode) {
          var ele = parseFloat(eleNode.textContent);

          if (prevLat !== null &amp;&amp; prevLon !== null) {
            totalDist += getDistanceKm(prevLat, prevLon, lat, lon);
          }

          labels.push(totalDist.toFixed(2));
          eleValues.push(Math.round(ele));

          prevLat = lat;
          prevLon = lon;
        }
      }

      
      var ctx = document.getElementById(&#39;chart-a94201a3&#39;).getContext(&#39;2d&#39;);
      new Chart(ctx, {
        type: &#39;line&#39;,
        data: {
          labels: labels,
          datasets: [{
            label: &#39;標高 (m)&#39;,
            data: eleValues,
            borderColor: &#39;#e03131&#39;,
            backgroundColor: &#39;rgba(224, 49, 49, 0.15)&#39;,
            fill: true,
            borderWidth: 2,
            pointRadius: 0,
            pointHoverRadius: 5,
            tension: 0.1
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              mode: &#39;index&#39;,
              intersect: false,
              callbacks: {
                title: function(items) { return &#39;距離: &#39; + items[0].label + &#39; km&#39;; },
                label: function(item) { return &#39;標高: &#39; + item.raw + &#39; m&#39;; }
              }
            }
          },
          scales: {
            x: {
              display: true,
              title: { display: true, text: &#39;距離 (km)&#39;, font: { size: 10 } },
              ticks: { maxTicksLimit: 10, font: { size: 10 } },
              grid: { color: &#39;rgba(0, 0, 0, 0.05)&#39; }
            },
            y: {
              display: true,
              title: { display: true, text: &#39;標高 (m)&#39;, font: { size: 10 } },
              ticks: { font: { size: 10 } },
              grid: { color: &#39;rgba(0, 0, 0, 0.05)&#39; }
            }
          }
        }
      });
    })
    .catch(function(err) {
      console.error(&#34;GPX Parsing Error:&#34;, err);
    });
});
&lt;/script&gt;&lt;/h2&gt;
&lt;h3 id=&#34;本文&#34;&gt;本文&lt;/h3&gt;
&lt;p&gt;「ここに道がなかったはずがない」シリーズ（笑）の3回目。カロー谷左岸の「滝入ノ道」、ゴンエ尾根から小雲取谷出合への捷路に続くのは、三ノ木戸集落から石尾根北面への仕事道。これも、無いはずが無い。&lt;/p&gt;</description>
