&lt;div class=&#34;gpx-container&#34;&gt;
  &lt;div id=&#34;map-d4d23bd2&#34; class=&#34;gpx-map&#34;&gt;&lt;/div&gt;
  &lt;div id=&#34;summary-d4d23bd2&#34; class=&#34;gpx-summary&#34;&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;総距離:&lt;strong id=&#34;sum-dist-d4d23bd2&#34;&gt;-&lt;/strong&gt; km&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;累積標高上り:&lt;strong id=&#34;sum-up-d4d23bd2&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;累積標高下り:&lt;strong id=&#34;sum-down-d4d23bd2&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;最高標高:&lt;strong id=&#34;sum-max-d4d23bd2&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;最低標高:&lt;strong id=&#34;sum-min-d4d23bd2&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&#34;gpx-chart-wrapper&#34;&gt;
    &lt;canvas id=&#34;chart-d4d23bd2&#34;&gt;&lt;/canvas&gt;
  &lt;/div&gt;
&lt;/div&gt;


&lt;script src=&#34;https://unpkg.com/leaflet@1.9.4/dist/leaflet.js&#34;&gt;&lt;/script&gt;
&lt;script src=&#34;https://cdnjs.cloudflare.com/ajax/libs/leaflet-gpx/1.7.0/gpx.min.js&#34;&gt;&lt;/script&gt;
&lt;script src=&#34;https://cdn.jsdelivr.net/npm/chart.js&#34;&gt;&lt;/script&gt;

&lt;script&gt;
window.addEventListener(&#39;load&#39;, function() {
  var gpxUrl = &#39;\/oohc\/posts\/2026-06-20\/20260620_20260620.gpx&#39;;

  
  var map = L.map(&#39;map-d4d23bd2&#39;).setView([0, 0], 10);
  L.tileLayer(&#39;https://cyberjapandata.gsi.go.jp/xyz/std/{z}/{x}/{y}.png&#39;, {
    attribution: &#39;&lt;a href=&#34;https://maps.gsi.go.jp/development/ichiran.html&#34; target=&#34;_blank&#34;&gt;国土地理院&lt;/a&gt;&#39;,
    maxZoom: 18
  }).addTo(map);

  var hoverMarker = null;
  var trackPoints = [];
  var timeLabels = []; 

  
  var ctx = document.getElementById(&#39;chart-d4d23bd2&#39;).getContext(&#39;2d&#39;);
  var chart = new Chart(ctx, {
    type: &#39;line&#39;,
    data: {
      labels: [],
      datasets: [{
        label: &#39;標高 (m)&#39;,
        data: [],
        borderColor: &#39;#007bff&#39;,
        backgroundColor: &#39;rgba(0, 123, 255, 0.1)&#39;,
        fill: true,
        borderWidth: 1.5,
        pointRadius: 0,
        pointHoverRadius: 6,
        tension: 0.1
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      interaction: { mode: &#39;index&#39;, intersect: false },
      plugins: {
        legend: { display: false },
        
        tooltip: {
          callbacks: {
            title: function(items) {
              var index = items[0].dataIndex;
              var timeStr = timeLabels[index] || &#39;&#39;;
              return timeStr ? &#39;時刻: &#39; + timeStr : &#39;&#39;;
            },
            label: function(item) {
              return &#39;標高: &#39; + item.raw + &#39; m&#39;;
            }
          }
        }
      },
      scales: {
        x: { display: true, title: { display: true, text: &#39;距離 (km)&#39;, font: { size: 10 } } },
        y: { display: true, title: { display: true, text: &#39;標高 (m)&#39;, font: { size: 10 } } }
      },
      
      onHover: function(event, activeElements) {
        if (activeElements &amp;&amp; activeElements.length &gt; 0) {
          var index = activeElements[0].index;
          updateHoverMarker(index);
        }
      }
    }
  });

  
  function updateHoverMarker(index) {
    var pt = trackPoints[index];
    if (pt) {
      if (!hoverMarker) {
        hoverMarker = L.circleMarker([pt.lat, pt.lng], {
          radius: 8,
          fillColor: &#39;#00ffff&#39;,
          color: &#39;#ffffff&#39;,
          weight: 3,
          opacity: 1,
          fillOpacity: 1
        }).addTo(map);
      } else {
        hoverMarker.setLatLng([pt.lat, pt.lng]);
      }
    }
  }

  
  function extractTrackData(layer) {
    var pts = [];
    var polylines = [];

    if (typeof layer.getLatLngs === &#39;function&#39;) {
      var latlngs = layer.getLatLngs();
      var flat = Array.isArray(latlngs[0]) ? latlngs.flat(Infinity) : latlngs;
      flat.forEach(function(p) {
        if (p &amp;&amp; typeof p.lat === &#39;number&#39;) {
          pts.push({ lat: p.lat, lng: p.lng });
        }
      });
      if (layer instanceof L.Polyline) {
        polylines.push(layer);
      }
    } else if (typeof layer.eachLayer === &#39;function&#39;) {
      layer.eachLayer(function(child) {
        var res = extractTrackData(child);
        pts = pts.concat(res.pts);
        polylines = polylines.concat(res.polylines);
      });
    }
    return { pts: pts, polylines: polylines };
  }

  
  fetch(gpxUrl)
    .then(function(response) { return response.text(); })
    .then(function(xmlText) {
      var parser = new DOMParser();
      var xmlDoc = parser.parseFromString(xmlText, &#34;text/xml&#34;);
      var trkpts = xmlDoc.getElementsByTagName(&#34;trkpt&#34;);

      for (var i = 0; i &lt; trkpts.length; i++) {
        var timeNode = trkpts[i].getElementsByTagName(&#34;time&#34;)[0];
        if (timeNode) {
          var dateObj = new Date(timeNode.textContent);
          var timeStr = dateObj.toLocaleTimeString([], { hour: &#39;2-digit&#39;, minute: &#39;2-digit&#39;, hour12: false });
          timeLabels.push(timeStr);
        } else {
          timeLabels.push(&#39;&#39;);
        }
      }
    })
    .catch(function(err) {
      console.error(&#34;GPX Time Parsing Error:&#34;, err);
    });

  
  new L.GPX(gpxUrl, {
    async: true,
    polyline_options: { color: &#39;#ff3300&#39;, weight: 5, opacity: 0.8 },
    marker_options: { startIconUrl: null, endIconUrl: null, wptIconUrls: null }
  }).on(&#39;loaded&#39;, function(e) {
    var gpx = e.target;
    map.fitBounds(gpx.getBounds());

    
    var distKm = (gpx.get_distance() / 1000).toFixed(2);
    var maxEle = Math.round(gpx.get_elevation_max());
    var minEle = Math.round(gpx.get_elevation_min());
    var gainEle = Math.round(gpx.get_elevation_gain());
    var lossEle = Math.round(gpx.get_elevation_loss());

    document.getElementById(&#39;sum-dist-d4d23bd2&#39;).innerText = distKm;
    document.getElementById(&#39;sum-up-d4d23bd2&#39;).innerText = gainEle;
    document.getElementById(&#39;sum-down-d4d23bd2&#39;).innerText = lossEle;
    document.getElementById(&#39;sum-max-d4d23bd2&#39;).innerText = maxEle;
    document.getElementById(&#39;sum-min-d4d23bd2&#39;).innerText = minEle;

    
    var eleData = gpx.get_elevation_data();
    var distLabels = [];
    var elevations = [];

    var extracted = extractTrackData(gpx);
    trackPoints = extracted.pts;

    
    if (trackPoints.length &gt; 0) {
      var startPt = trackPoints[0];
      var endPt = trackPoints[trackPoints.length - 1];

      L.circleMarker([startPt.lat, startPt.lng], {
        radius: 9,
        fillColor: &#39;#28a745&#39;,
        color: &#39;#ffffff&#39;,
        weight: 2,
        opacity: 1,
        fillOpacity: 0.9
      }).addTo(map).bindTooltip(&#39;スタート&#39;, { permanent: false, direction: &#39;top&#39; });

      L.circleMarker([endPt.lat, endPt.lng], {
        radius: 9,
        fillColor: &#39;#dc3545&#39;,
        color: &#39;#ffffff&#39;,
        weight: 2,
        opacity: 1,
        fillOpacity: 0.9
      }).addTo(map).bindTooltip(&#39;ゴール&#39;, { permanent: false, direction: &#39;top&#39; });
    }

    eleData.forEach(function(item) {
      var dist = typeof item[0] === &#39;number&#39; ? item[0] : parseFloat(item[0]);
      distLabels.push(dist.toFixed(2));
      elevations.push(Math.round(item[1]));
    });

    chart.data.labels = distLabels;
    chart.data.datasets[0].data = elevations;
    chart.update();

    
    extracted.polylines.forEach(function(polyline) {
      polyline.on(&#39;mousemove&#39;, function(ev) {
        if (!trackPoints.length) return;

        var mouseLatLng = ev.latlng;
        var closestIndex = 0;
        var minDist = Infinity;

        for (var i = 0; i &lt; trackPoints.length; i++) {
          var d = mouseLatLng.distanceTo(L.latLng(trackPoints[i].lat, trackPoints[i].lng));
          if (d &lt; minDist) {
            minDist = d;
            closestIndex = i;
          }
        }

        updateHoverMarker(closestIndex);

        chart.setActiveElements([{ datasetIndex: 0, index: closestIndex }]);
        chart.tooltip.setActiveElements([{ datasetIndex: 0, index: closestIndex }], { x: 0, y: 0 });
        chart.update();
      });
    });

  }).addTo(map);
});
&lt;/script&gt;
&lt;hr&gt;
&lt;h3 id=&#34;山行記録&#34;&gt;山行記録&lt;/h3&gt;
&lt;h4 id=&#34;ヒカゲザス尾根&#34;&gt;  ヒカゲザス尾根&lt;/h4&gt;
&lt;p&gt;本レポートのメインテーマではないが、少し触れておきたい。
記録者のなかでは、ヒカゲザス尾根はかなり特徴的な位置づけになりつつある。
まず、何か所かある露岩の急斜面が登りにくい。「岩崖」ほどではないのでハイカーでもたどれるが、難度はけっこう高い。露岩の斜面を回避する踏み跡も目につく。ルート取りであれこれ考えさせられ、「次は別のラインで上がってみようか」の気分にさせられる尾根は、多くはない。
そして、その険しい尾根の周辺で見かける植林エリアが、とても丁寧に手入れされている。通いにくい山奥の山林を守る労力は、並大抵のものではないだろう。ただ頭が下がるばかりだ。―― 性懲りもなく「いったいどうやって通うのだろう」の疑問がワンセットで湧いてくるのは、呆れて許していただきたいが。&lt;/p&gt;</description>
