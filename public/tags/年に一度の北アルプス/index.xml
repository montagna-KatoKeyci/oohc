    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    font-family: sans-serif;
  }
  .gpx-map { height: 380px; width: 100%; }
  
   
  .gpx-summary {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    align-items: center;
    background: #f8f9fa;
