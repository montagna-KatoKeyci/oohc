    border-bottom: 1px solid #e0e0e0;
    font-size: 0.8rem;
    color: #333;
    overflow-x: auto;
    white-space: nowrap;
  }
  .gpx-summary-item {
    margin: 0 4px;
  }
  .gpx-summary-item strong {
    color: #007bff;
