&lt;link rel=&#34;stylesheet&#34; href=&#34;https://unpkg.com/leaflet@1.9.4/dist/leaflet.css&#34; /&gt;
&lt;style&gt;
  .gpx-container {
    width: 100%;
    margin: 1.5rem 0;
    border: 1px solid #ccc;
    border-radius: 8px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    font-family: sans-serif;
  }
  .gpx-map { height: 380px; width: 100%; }
  
   
  .gpx-summary {
    display: flex;
