  &lt;div id=&#34;map-28131025&#34; class=&#34;gpx-map&#34;&gt;&lt;/div&gt;
  &lt;div id=&#34;summary-28131025&#34; class=&#34;gpx-summary&#34;&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;総距離:&lt;strong id=&#34;sum-dist-28131025&#34;&gt;-&lt;/strong&gt; km&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;累積標高上り:&lt;strong id=&#34;sum-up-28131025&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;累積標高下り:&lt;strong id=&#34;sum-down-28131025&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;最高標高:&lt;strong id=&#34;sum-max-28131025&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
    &lt;div class=&#34;gpx-summary-item&#34;&gt;最低標高:&lt;strong id=&#34;sum-min-28131025&#34;&gt;-&lt;/strong&gt; m&lt;/div&gt;
  &lt;/div&gt;
  &lt;div class=&#34;gpx-chart-wrapper&#34;&gt;
    &lt;canvas id=&#34;chart-28131025&#34;&gt;&lt;/canvas&gt;
  &lt;/div&gt;
